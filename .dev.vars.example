# Copy to .dev.vars for local-only secrets. Never commit .dev.vars.
SESSION_HMAC_KEY=replace-with-at-least-32-random-bytes
CSRF_HMAC_KEY=replace-with-a-different-at-least-32-random-bytes
RATE_LIMIT_HMAC_KEY=replace-with-a-third-at-least-32-random-bytes
UPLOAD_HMAC_KEY=replace-with-an-upload-specific-at-least-32-random-bytes
SCANNER_HMAC_KEY=replace-with-a-scanner-specific-at-least-32-random-bytes
RESEND_API_KEY=replace-with-a-resend-api-key
# Deployed direct-to-R2 uploads require a least-privilege object-write token.
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
R2_BUCKET_NAME=sessionbuddy-assets-development
R2_ACCESS_KEY_ID=replace-with-r2-object-write-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-object-write-secret
