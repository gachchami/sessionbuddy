{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sessionbuddy",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["python_workers", "python_workflows"],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sessionbuddy-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations_baseline"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "sessionbuddy-assets-local"
    }
  ],
  "queues": {
    "producers": [
      {"binding": "ASSET_SCAN_QUEUE", "queue": "sessionbuddy-asset-scans"},
      {"binding": "COMMUNICATION_QUEUE", "queue": "sessionbuddy-communications"}
    ],
    "consumers": [
      {
        "queue": "sessionbuddy-asset-scans",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "sessionbuddy-asset-scans-dlq"
      },
      {
        "queue": "sessionbuddy-communications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "sessionbuddy-communications-dlq"
      }
    ]
  },
  "workflows": [
    {
      "name": "sessionbuddy-reminders",
      "binding": "REMINDER_WORKFLOW",
      "class_name": "ReminderWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {"limit": 10, "period": 60}
    },
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {"limit": 50, "period": 60}
    },
    {
      "name": "CFP_UPLOAD_AUTH_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {"limit": 10, "period": 60}
    },
    {
      "name": "CFP_UPLOAD_POLL_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {"limit": 240, "period": 60}
    },
    {
      "name": "SPEAKER_UPLOAD_AUTH_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": {"limit": 3, "period": 60}
    },
    {
      "name": "HEADSHOT_UPLOAD_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": {"limit": 3, "period": 60}
    },
    {
      "name": "MAGIC_LINK_RECIPIENT_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": {"limit": 3, "period": 60}
    },
    {
      "name": "MAGIC_LINK_SOURCE_RATE_LIMITER",
      "namespace_id": "1008",
      "simple": {"limit": 10, "period": 60}
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "APP_VERSION": "development",
    "ALLOWED_ORIGINS": "http://127.0.0.1:8787,http://localhost:8787,http://worker:8787,https://localhost:8443,https://perceived-dark-helena-hours.trycloudflare.com",
    "MALWARE_SCAN_MODE": "required",
    "PUBLIC_BASE_URL": "https://perceived-dark-helena-hours.trycloudflare.com",
    "MAILPIT_API_URL": "http://mailpit:8025",
    "RESEND_FROM_ADDRESS": "SessionBuddy Local <events@example.test>",
    "SCANNER_URL": "http://scanner:8080"
  },
  "env": {
    "dev": {
      "name": "sessionbuddy-development",
      "triggers": {
        "crons": ["*/2 * * * *"]
      },
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sessionbuddy-development-clean",
          "database_id": "367e2a09-c440-4db1-a265-e41e26acbe3e",
          "migrations_dir": "migrations_baseline"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "sessionbuddy-assets-development"
        }
      ],
      "queues": {
        "producers": [
          {"binding": "ASSET_SCAN_QUEUE", "queue": "sessionbuddy-asset-scans"},
          {"binding": "COMMUNICATION_QUEUE", "queue": "sessionbuddy-communications"}
        ],
        "consumers": [
          {
            "queue": "sessionbuddy-asset-scans",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "sessionbuddy-asset-scans-dlq"
          },
          {
            "queue": "sessionbuddy-communications",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "sessionbuddy-communications-dlq"
          }
        ]
      },
      "workflows": [
        {
          "name": "sessionbuddy-reminders-development",
          "binding": "REMINDER_WORKFLOW",
          "class_name": "ReminderWorkflow"
        }
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {"limit": 10, "period": 60}
        },
        {
          "name": "PUBLIC_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {"limit": 50, "period": 60}
        },
        {
          "name": "CFP_UPLOAD_AUTH_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": {"limit": 10, "period": 60}
        },
        {
          "name": "CFP_UPLOAD_POLL_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": {"limit": 240, "period": 60}
        },
        {
          "name": "SPEAKER_UPLOAD_AUTH_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": {"limit": 3, "period": 60}
        },
        {
          "name": "HEADSHOT_UPLOAD_RATE_LIMITER",
          "namespace_id": "1006",
          "simple": {"limit": 3, "period": 60}
        },
        {
          "name": "MAGIC_LINK_RECIPIENT_RATE_LIMITER",
          "namespace_id": "1007",
          "simple": {"limit": 3, "period": 60}
        },
        {
          "name": "MAGIC_LINK_SOURCE_RATE_LIMITER",
          "namespace_id": "1008",
          "simple": {"limit": 10, "period": 60}
        }
      ],
      "limits": {
        "cpu_ms": 5000
      },
      "vars": {
        "APP_ENV": "development",
        "APP_VERSION": "development",
        "ALLOWED_ORIGINS": "https://sessionbuddy-development.shiny-cloud-dd47.workers.dev",
        "CLOUDFLARE_ACCOUNT_ID": "11b5e48aa7648b805e4602b5e980beb2",
        "MALWARE_SCAN_MODE": "disabled",
        "PUBLIC_BASE_URL": "https://sessionbuddy-development.shiny-cloud-dd47.workers.dev",
        "R2_BUCKET_NAME": "sessionbuddy-assets-development",
        "RESEND_FROM_ADDRESS": "SessionBuddy <notifications@mail.noneli.com>",
        "SCANNER_URL": "",
        "SKIP_PROFILE_ONBOARDING": "true"
      }
    }
  }
}
