{
  "name": "sessionbuddy-cloudflare-toolchain",
  "private": true,
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "frontend:check": "tsc --noEmit -p frontend/tsconfig.json",
    "worker:sync": "uv run pywrangler sync",
    "worker:dev": "uv run pywrangler dev",
    "worker:migrate": "uv run pywrangler d1 migrations apply DB --local",
    "worker:migrate:dev": "uv run pywrangler d1 migrations apply DB --remote --env dev",
    "worker:deploy:dev": "uv run pywrangler deploy --env dev",
    "worker:preflight:dev": "uv run python scripts/cloudflare_preflight.py --env dev --deployment-only",
    "worker:activation:preflight:dev": "uv run python scripts/cloudflare_preflight.py --env dev",
    "worker:bootstrap:dev": "uv run python scripts/bootstrap_cloudflare.py --env dev"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "4.120.0"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
